# Copy to .env. Never put provider credentials into frontend files.
DATA_DIR=./data
# semantic: real local embeddings; lexical: deterministic offline mode
EMBEDDING_BACKEND=lexical
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# auto: use the chat model when configured, otherwise grounded local answers
# extractive: always local grounded answers; llm: require a provider
ANSWER_MODE=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# Set a strong shared token before exposing beyond your own computer.
APP_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=20
MAX_CHUNKS=10000
MAX_PDF_PAGES=500
MAX_CONTEXT_CHARS=14000
HISTORY_TURNS=6
RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=30
# Optional OCR for image-only PDFs (requires pdf2image + pytesseract + Tesseract)
ENABLE_OCR=false
