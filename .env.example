# Production / Runtime Environment
APP_ENV=production
FRONTEND_URL=https://muldocrag.vercel.app
CORS_ORIGINS=https://muldocrag.vercel.app

# Storage and Limits
DATA_DIR=./data
MAX_UPLOAD_MB=20
MAX_CHUNKS=10000
MAX_PDF_PAGES=500
MAX_CONTEXT_CHARS=14000
HISTORY_TURNS=6
RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=30
ENABLE_OCR=false

# Retrieval: lexical (offline/lightweight) or semantic (sentence-transformers)
EMBEDDING_BACKEND=lexical
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Generation: auto, extractive or llm
ANSWER_MODE=auto
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Optional shared workspace token
APP_TOKEN=
